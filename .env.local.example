# Copy this file to .env.local and set your own values.

# Used only the very first time you log in — after that, your password is
# stored as a bcrypt hash in data/admin.json, and you manage it from
# /admin/settings instead of this file.
ADMIN_PASSWORD=changeme123

# Signs the admin login session (JWT). Use a long random string in anything
# beyond local/self-hosted use. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
